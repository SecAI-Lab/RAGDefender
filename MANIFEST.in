# Files shipped in the sdist/wheel beyond what setuptools auto-discovers.
# pyproject.toml drives the actual package build; this file only adds extra
# loose files (license, readme, requirements) and removes anything we never
# want shipped (tests, claims/, artifacts/, build cruft).

# Loose files included at the package root
include README_PYPI.md
include LICENSE
include requirements.txt
include pyproject.toml

# Strip the usual cruft
global-exclude *.py[cod]
global-exclude __pycache__
global-exclude *.so
global-exclude *.dylib
global-exclude .DS_Store
global-exclude *.swp
global-exclude *~

# Keep CI / dev / build artifacts out of the wheel
exclude .pre-commit-config.yaml
exclude .flake8
exclude tox.ini
recursive-exclude .github *
recursive-exclude .eggs *
recursive-exclude *.egg-info *
recursive-exclude build *
recursive-exclude dist *

# Keep paper artifacts and reproducibility scaffolding out of the wheel
recursive-exclude tests *
recursive-exclude docs *
recursive-exclude examples *
recursive-exclude claims *
recursive-exclude artifacts *
recursive-exclude infrastructure *
recursive-exclude poisoned_corpus *

# Never ship model weights through PyPI
global-exclude *.pt *.pth *.bin *.ckpt *.safetensors
